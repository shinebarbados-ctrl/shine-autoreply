# ---------- Core ----------
PORT=3000
# Set to true to log outgoing replies instead of sending them (safe testing)
DRY_RUN=false
# Any long random string. Used to protect /admin endpoints
ADMIN_TOKEN=change-me-to-a-long-random-string

# ---------- Webhook security ----------
# You choose this. Paste the same value into Meta when registering the webhook
WEBHOOK_VERIFY_TOKEN=shine-verify-2026
# Meta app secret (App settings > Basic). Used to verify WhatsApp webhooks
META_APP_SECRET=
# Instagram app secret (Instagram > API setup with Instagram login). Leave blank if same as above
IG_APP_SECRET=

# ---------- Claude ----------
ANTHROPIC_API_KEY=
# claude-sonnet-5 for best replies, claude-haiku-4-5-20251001 for lowest cost
ANTHROPIC_MODEL=claude-sonnet-5

# ---------- WhatsApp Cloud API ----------
GRAPH_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
# Permanent System User token with whatsapp_business_messaging permission
WHATSAPP_TOKEN=

# ---------- Instagram (API with Instagram Login) ----------
# Your Instagram professional account ID
IG_ACCOUNT_ID=
# Long-lived Instagram User access token with instagram_business_manage_messages
IG_ACCESS_TOKEN=

# ---------- Human handoff ----------
# Make.com (or Zapier) webhook URL. Receives a JSON alert whenever the bot hands a chat to a human
HANDOFF_WEBHOOK_URL=
# Your personal WhatsApp in international format, no +. Gets a text alert if it has messaged the business number in the last 24h
OWNER_WHATSAPP=
# Hours the bot stays silent in a chat after a handoff or after a human replies
HANDOFF_PAUSE_HOURS=12

# ---------- Behaviour ----------
# Seconds to wait for a customer to finish typing before replying (bundles rapid messages)
REPLY_DEBOUNCE_SECONDS=4
# Booking link the bot shares (Setmore etc.)
BOOKING_URL=
